---
import site from '../../content/site.json';
import { url } from '../lib/url';

const path = Astro.url.pathname.replace(import.meta.env.BASE_URL.replace(/\/$/, ''), '') || '/';
const isCurrent = (href: string) =>
  href === '/' ? path === '/' : path === href || path.startsWith(href + '/');
---
<header class="site-header">
  <div class="bar">
    <a class="wordmark" href={url('/')} aria-label={`${site.name}, home`}>
      Andrew des<span class="i">i</span>gns<span class="dot" aria-hidden="true">.</span>
    </a>
    <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="site-nav">
      <span class="visually-hidden">Menu</span>
      <span class="lines" aria-hidden="true"></span>
    </button>
    <nav id="site-nav" aria-label="Main">
      <ul>
        {site.nav.map((item) => (
          <li><a href={url(item.href)} aria-current={isCurrent(item.href) ? 'page' : undefined}>{item.label}</a></li>
        ))}
        <li>
          <a href={site.linkedin} class="icon" rel="me noopener">
            <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" focusable="false"><path fill="currentColor" d="M4.98 3.5a2.5 2.5 0 1 1 0 5 2.5 2.5 0 0 1 0-5zM3 9.75h4v11.25H3zM9.5 9.75h3.83v1.54h.06c.53-1 1.84-2.06 3.79-2.06 4.05 0 4.8 2.66 4.8 6.13V21h-4v-5.02c0-1.2-.02-2.74-1.67-2.74-1.67 0-1.93 1.3-1.93 2.65V21h-4z"/></svg>
            <span class="label">LinkedIn</span>
          </a>
        </li>
      </ul>
    </nav>
  </div>
</header>

<script>
  const button = document.querySelector<HTMLButtonElement>('.menu-toggle');
  const header = document.querySelector('.site-header');
  button?.addEventListener('click', () => {
    const open = button.getAttribute('aria-expanded') !== 'true';
    button.setAttribute('aria-expanded', String(open));
    header?.classList.toggle('is-open', open);
  });
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && header?.classList.contains('is-open')) {
      header.classList.remove('is-open');
      button?.setAttribute('aria-expanded', 'false');
      button?.focus();
    }
  });
</script>

<style>
  .site-header { border-bottom: 1px solid var(--color-ink); background: var(--color-paper); }
  .bar {
    max-width: calc(90rem + 2 * var(--gutter)); margin-inline: auto; padding: var(--space-3) var(--gutter);
    display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 0 var(--space-4);
  }
  .wordmark { font-size: 1.75rem; font-weight: var(--weight-regular); letter-spacing: 0; text-decoration: none; line-height: 1.2; padding-block: var(--space-2); }
  .dot { color: var(--color-accent); }
  /* Gold tittle on the i, as in the original logo: a gold i under a dotless ı in ink */
  .i { position: relative; color: transparent; }
  .i::before, .i::after { position: absolute; left: 0; top: 0; }
  .i::before { content: 'i'; color: var(--color-accent); clip-path: inset(0 0 55% 0); }
  .i::after { content: 'ı'; color: var(--color-ink); }
  ul { list-style: none; margin: 0; padding: 0; display: flex; gap: 0 var(--space-4); align-items: center; }
  nav a { text-decoration: none; font-size: 0.95rem; display: inline-flex; align-items: center; gap: var(--space-2); min-height: 44px; }
  nav a:hover, nav a[aria-current='page'] { text-decoration: underline; text-decoration-color: var(--color-accent); }
  .icon .label { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }

  /* Mobile: two-line menu button that opens a stacked list, as on the original site */
  .menu-toggle { display: none; }
  @media (max-width: 719px) {
    .menu-toggle {
      display: inline-flex; align-items: center; justify-content: center;
      width: 44px; height: 44px; margin-right: -8px; padding: 0;
      background: none; border: 0; color: var(--color-ink); cursor: pointer;
    }
    .lines, .lines::after {
      display: block; width: 36px; height: 1.5px; background: currentColor;
      transition: transform var(--duration-base) var(--ease-out);
    }
    .lines { position: relative; transform: translateY(-5px); }
    .lines::after { content: ''; position: absolute; left: 0; top: 10px; }
    .is-open .lines { transform: translateY(0) rotate(45deg); }
    .is-open .lines::after { transform: translateY(-10px) rotate(-90deg); }

    nav { display: none; flex-basis: 100%; }
    .is-open nav { display: block; }
    ul { flex-direction: column; align-items: flex-start; padding-block: var(--space-2) var(--space-4); }
    nav a { font-size: 1.5rem; }
    .icon .label { position: static; width: auto; height: auto; overflow: visible; clip: auto; }
  }
</style>
