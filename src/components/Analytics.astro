---
// Google Analytics 4. Renders nothing until a Measurement ID ("G-...") is set
// as "ga4" in content/site.json, and never in local dev.
import site from '../../content/site.json';
const id = (site as { ga4?: string }).ga4?.trim();
const enabled = Boolean(id) && import.meta.env.PROD;
---
{enabled && (
  <>
    <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${id}`}></script>
    <script is:inline define:vars={{ id }}>
      window.dataLayer = window.dataLayer || [];
      function gtag() { dataLayer.push(arguments); }
      gtag('js', new Date());
      gtag('config', id, { anonymize_ip: true });
    </script>
  </>
)}
