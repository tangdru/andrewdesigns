---
import { getEntry, render } from 'astro:content';
import Base from '../layouts/Base.astro';
import { url, inline } from '../lib/url';

const page = (await getEntry('pages', 'visual-design'))!;
const { Content } = await render(page);
---
<Base title={page.data.title} description={page.data.description}>
  {page.data.cover && (
    <div class="cover"><img src={url(page.data.cover)} alt="" fetchpriority="high" decoding="async" /></div>
  )}
  <div class="wrap">
    <h1 class="visually-hidden">{page.data.title}</h1>
    {page.data.intro && <p class="intro" set:html={inline(page.data.intro)} />}
    <div class="prose">
      <Content />
    </div>
  </div>
</Base>

<style>
  .cover { background: var(--color-wash); }
  .cover img { width: 100%; max-height: 60vh; object-fit: cover; }
  .intro { font-size: var(--size-h1); line-height: 1.25; max-width: 24em; margin: var(--space-6) auto var(--space-5); max-width: var(--content-max); }
  .intro :global(strong) { color: var(--color-accent-text); font-weight: var(--weight-medium); }
</style>
