---
import { getEntry, render } from 'astro:content';
import Base from '../layouts/Base.astro';
import { url, inline } from '../lib/url';
import Lightbox from '../components/Lightbox.astro';

const page = (await getEntry('pages', 'visual-design'))!;
const { Content } = await render(page);
const g = page.data.grid;
const gridVars = g ? `--text:${g.text};--mtext:${g.mtext}` : undefined;
---
<Base title={page.data.title} description={page.data.description}>
  {page.data.cover && (
    <div class="cover"><img src={url(page.data.cover)} alt="" fetchpriority="high" decoding="async" /></div>
  )}
  <h1 class="visually-hidden">{page.data.title}</h1>
  {page.data.intro && (
    <div class="page-grid" style={gridVars}><p class="intro" set:html={inline(page.data.intro)} /></div>
  )}
  <div class="prose page-grid" style={gridVars}>
    <Content />
  </div>
  <Lightbox />
</Base>

<script>
  import Muuri from 'muuri';

  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const token = (name: string) => getComputedStyle(document.documentElement).getPropertyValue(name).trim();
  // Durations may come back minified as seconds (550ms → .55s).
  const ms = (name: string) => {
    const v = token(name);
    return reduceMotion ? 0 : parseFloat(v) * (v.endsWith('ms') ? 1 : 1000);
  };
  const easing = token('--ease-out');

  document.querySelectorAll<HTMLElement>('.masonry').forEach((el) => {
    el.classList.add('is-muuri');
    const grid = new Muuri(el, {
      items: '.masonry-item',
      // Filtering: the rest of the grid glides into place while items
      // leaving shrink and fade out, and items arriving grow and fade in.
      layoutDuration: ms('--duration-slow'),
      layoutEasing: easing,
      showDuration: ms('--duration-slow'),
      showEasing: easing,
      hideDuration: ms('--duration-base'),
      hideEasing: easing,
      visibleStyles: { opacity: '1', transform: 'scale(1)' },
      hiddenStyles: { opacity: '0', transform: `scale(${token('--scale-hidden')})` },
      layoutOnResize: 150,
    });
    // Images carry width/height so sizes are known up front; re-measure once loaded anyway.
    el.querySelectorAll('img').forEach((img) => {
      if (!img.complete) img.addEventListener('load', () => grid.refreshItems().layout(), { once: true });
    });

    // Filter buttons sit before the gallery in the content.
    const bar = document.querySelector<HTMLElement>('.filters');
    if (!bar) return;
    const buttons = [...bar.querySelectorAll<HTMLButtonElement>('[data-filter]')];
    const status = document.createElement('p');
    status.className = 'visually-hidden';
    status.setAttribute('role', 'status');
    bar.append(status);

    const apply = (key: string, announce = true) => {
      if (!buttons.some((b) => b.dataset.filter === key)) key = 'all';
      buttons.forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.filter === key)));
      grid.filter((item) => key === 'all' || item.getElement()?.dataset.category === key);
      if (announce) {
        const label = buttons.find((b) => b.dataset.filter === key)?.textContent;
        const count = grid.getItems().filter((i) => i.isActive()).length;
        status.textContent = `${label}: ${count} images`;
      }
    };

    buttons.forEach((b) =>
      b.addEventListener('click', () => {
        const key = b.dataset.filter!;
        // Lazy images further down the page would arrive blank; fetch them now.
        el.querySelectorAll('img[loading="lazy"]').forEach((img) => img.setAttribute('loading', 'eager'));
        history.replaceState(null, '', key === 'all' ? location.pathname + location.search : `#${key}`);
        apply(key);
      }),
    );
    bar.hidden = false;
    apply(location.hash.slice(1) || 'all', false);
  });
</script>

<style>
  .cover { background: var(--color-wash); }
  .cover img { width: 100%; max-height: 60vh; object-fit: cover; }
  .intro { font-size: var(--size-h1); line-height: var(--leading-heading); margin-block: var(--space-6) var(--space-5); }
  .intro :global(strong) { color: var(--color-accent); font-weight: var(--weight-bold); }
</style>
